---
layout: default
---
<article class="cv">
  <h1>Curriculum vitae</h1>
  {% assign cv = site.data.cv.cv %}
  <p>{{ cv.summary }}</p>
  {% for section in cv.sections %}
    <h2>{{ section[0] }}</h2>
    {% for item in section[1] %}
      <div class="cv-entry">
        <div class="cv-date">
          {% if item.start_date %}{{ item.start_date | date: '%Y' }}–{% if item.end_date != blank %}{{ item.end_date | date: '%Y' }}{% else %}present{% endif %}{% else %}{{ item.date }}{% endif %}
        </div>
        <div>
          <h3>{{ item.position | default: item.studyType | default: item.name | default: item.title }}</h3>
          {% if item.institution or item.company or item.awarder %}<p class="cv-institution">{% if item.url %}<a href="{{ item.url }}">{% endif %}{{ item.institution | default: item.company | default: item.awarder }}{% if item.url %}</a>{% endif %}{% if item.area %} · {{ item.area }}{% endif %}</p>{% endif %}
          {% if item.location %}<p class="cv-location">{{ item.location }}</p>{% endif %}
          {% if item.summary %}<p>{{ item.summary }}</p>{% endif %}
          {% if item.highlights %}<ul>{% for highlight in item.highlights %}<li>{{ highlight }}</li>{% endfor %}</ul>{% endif %}
        </div>
      </div>
    {% endfor %}
  {% endfor %}
  <h2>Publications</h2>
  <p>See the <a href="{{ '/publications/' | relative_url }}">full publication list</a> for papers, posters, and slides.</p>
  <h2>Teaching & service</h2>
  <p>See <a href="{{ '/teaching/' | relative_url }}">teaching and academic service</a>.</p>
</article>
