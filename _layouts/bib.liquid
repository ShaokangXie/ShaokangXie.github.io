---
---
<article class="publication" id="{{ entry.key }}">
  <h3 class="pub-title">
    {% if entry.html %}<a href="{{ entry.html }}">{{ entry.title }}</a>{% else %}{{ entry.title }}{% endif %}
  </h3>
  <div class="pub-authors">
    {%- for author in entry.author_array -%}
      {%- assign last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
      {%- assign last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
      {%- assign author_is_self = false -%}
      {%- if site.scholar.last_name contains last_name and site.scholar.first_name contains author.first -%}
        {%- assign author_is_self = true -%}
      {%- endif -%}
      {%- assign coauthor_url = nil -%}
      {%- assign coauthor_key = last_name | downcase | remove_accents -%}
      {%- for coauthor in site.data.coauthors[coauthor_key] -%}
        {%- if coauthor.firstname contains author.first -%}{%- assign coauthor_url = coauthor.url -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- unless forloop.first -%}{%- if forloop.last -%}{{ ', and ' }}{%- else -%}{{ ', ' }}{%- endif -%}{%- endunless -%}
      {%- if author_is_self -%}<strong>{{ author.first }} {{ last_html }}</strong>{%- elsif coauthor_url -%}<a href="{{ coauthor_url }}">{{ author.first }} {{ last_html }}</a>{%- else -%}{{ author.first }} {{ last_html }}{%- endif -%}
    {%- endfor -%}
  </div>
  <div class="pub-venue">{{ entry.abbr | default: entry.journal | default: entry.booktitle }}</div>
  {% if entry.additional_info %}<div class="pub-note">{{ entry.additional_info }}</div>{% endif %}
  <div class="pub-links">
    {% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{% endif %}
    {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}">DOI</a>{% endif %}
    {% unless entry.arxiv or entry.doi %}{% if entry.html %}<a href="{{ entry.html }}">Paper</a>{% endif %}{% endunless %}
    {% if entry.pdf %}{% assign resource = entry.pdf %}{% include paper-resource.liquid label='PDF' %}{% endif %}
    {% if entry.code %}<a href="{{ entry.code }}">Code</a>{% endif %}
    {% if entry.poster %}{% assign resource = entry.poster %}{% include paper-resource.liquid label='Poster' %}{% endif %}
    {% if entry.slides %}{% assign resource = entry.slides %}{% include paper-resource.liquid label='Slides' %}{% endif %}
    {% if entry.bibtex_show %}
      <details class="bib-details">
        <summary>BibTeX</summary>
        <pre><code>{{ entry.bibtex | hideCustomBibtex | escape }}</code></pre>
      </details>
    {% endif %}
  </div>
</article>
